# Copy to ".env" (Vite auto-loads it). Must be prefixed with VITE_ to be exposed to the browser.
VITE_API_URL=http://localhost:5000/api

# Google Analytics 4 Measurement ID (e.g. "G-XXXXXXXXXX"). Leave blank to disable analytics
# entirely - components/GoogleAnalytics.jsx becomes a no-op with no ID set.
VITE_GA_MEASUREMENT_ID=
