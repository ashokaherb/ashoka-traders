{
  "name": "ashoka-traders-backend",
  "version": "1.0.0",
  "description": "REST API for Ashoka Traders e-commerce site (Express + MongoDB)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node seed/seedAdmin.js",
    "seed:phase2": "node seed/seedPhase2.js",
    "migrate:slugs": "node seed/migrateSlugs.js",
    "test": "node --test --test-concurrency=1 tests/",
    "test:watch": "node --test --watch tests/",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 tests/",
    "verify:email": "node scripts/verifyEmail.js",
    "verify:trust-proxy": "node scripts/verifyTrustProxy.js",
    "db:backup": "node scripts/backupDatabase.js",
    "db:wipe": "node scripts/wipeStoreData.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.15.0",
    "razorpay": "^2.9.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.1"
  }
}
