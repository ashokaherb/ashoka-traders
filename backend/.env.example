# Copy this file to ".env" and fill in real values. Never commit the real ".env".

# Server
PORT=5000
NODE_ENV=development

# The backend's own publicly-reachable URL (no trailing slash). Used to build absolute
# URLs for uploaded product images (see utils/imageProcessing.js), since the storefront/
# admin apps run on different origins and a relative "/uploads/..." path would resolve
# against the wrong one. Update this to your real backend domain in production.
BACKEND_PUBLIC_URL=http://localhost:5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ashoka_traders

# JWT auth - see utils/generateToken.js. Durations: number + s/m/h/d.
JWT_SECRET=replace_with_a_long_random_string
# Customer login lifetime. The storefront refreshes it silently while the customer is active.
JWT_EXPIRES_IN=7d
# Admin login lifetime - kept short on purpose. Admin sessions can't be refreshed.
JWT_ADMIN_EXPIRES_IN=24h
# Longest a customer can stay logged in via silent refreshes before re-entering their password.
JWT_MAX_SESSION=30d

# One-time admin seed (used only by "npm run seed:admin").
# ADMIN_EMAIL also receives all admin alert emails (new orders, refunds, contact form).
ADMIN_NAME=Admin
ADMIN_EMAIL=
# Leave blank to have a strong random password generated and printed once (recommended).
# If you set one, it must be 12+ characters - placeholders like "changeme123" are refused.
ADMIN_PASSWORD=

# Allowed frontend origins (comma separated) for CORS
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Razorpay - test mode keys from your Razorpay dashboard (Settings > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Outgoing email (order confirmation + admin new-order alert). Leave blank to just
# log emails to the console instead of actually sending them - handy for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# WhatsApp (via a BSP like AiSensy or Interakt - see utils/whatsappService.js and the
# README's WhatsApp setup section). Leave blank to just log messages to the console.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
# The shop's own WhatsApp number, to receive new-order and contact-query alerts.
ADMIN_WHATSAPP_NUMBER=

# Cloudinary (product image uploads - see config/cloudinary.js and middleware/cloudinaryUpload.js).
# Free account at cloudinary.com - these three values are on your dashboard home page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
